# Configure these in Netlify UI. Never commit real secret values.
GITHUB_TOKEN=
OCTON_APPROVAL_SECRET=
OCTON_GITHUB_WRITE_ENABLED=false

# Optional. Leave OPENAI_API_KEY empty to run stages 01-06 only; stages 07-09 remain N/A.
OPENAI_API_KEY=
# Configure a model explicitly only when enabling API research.
OCTON_RESEARCH_MODEL=
OCTON_WEB_SEARCH_CONTEXT=high
GOOGLE_PAGESPEED_API_KEY=

GITHUB_OWNER=AdrianAlbertoMoraSinning
OCTON_GITHUB_REPO=Please
OCTON_GITHUB_BRANCH=main
OCTON_CODE_SCAN_MAX_FILES=600

OCTON_PORTAL_NAME=P.L.E.A.S.E.
OCTON_PORTAL_URL=https://pleasewebportal.netlify.app/
OCTON_RUNTIME_PATHS=/,/service-request.html,/track-request.html
OCTON_PORTAL_BUSINESS=multi-service local services marketplace and operations portal
OCTON_PORTAL_MARKET=Calgary and surrounding areas, Alberta, Canada
OCTON_PORTAL_JURISDICTION=Alberta, Canada

# External GitHub App authorization
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
OCTON_GITHUB_APP_SLUG=
